<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">
    <!--
        本分支（VeriRandom）的视觉身份层。

        这里是“与上游看起来不是同一个软件”的集中收口点：窗口顶部的品牌色装饰条、主窗口的顶部导航
        （上游是常驻左侧图标栏）。所有差异都写在新增文件里，样式覆盖通过 StylesBase.axaml 末尾的
        一行 StyleInclude 生效，上游同步时冲突面只有那一行和少数几个默认值常量。

        颜色不写死：装饰条与导航选中态都用 Fluent 的强调色资源，跟随用户在当前主题里的强调色
        （默认强调色由 GlobalConstants.DefaultThemeColor 决定）。
    -->

    <!-- 窗口顶部品牌色装饰条：主窗口与设置窗口共用，只在它们的最外层各放一个 Border -->
    <Style Selector="Border.fork-accent-strip">
        <Setter Property="Height" Value="3" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <!--
        顶部导航（MainView）。横向项模板由 FluentAvalonia 的顶部导航主题提供，这里只调高度，
        让一行项比上游的侧栏图标更宽松；颜色与选中指示条沿用主题的强调色，不做硬编码。
        不要在这里重写 FANavigationViewItemPresenter 的模板：顶部模式的项由框架自己的模板呈现，
        覆盖模板会连带丢掉溢出菜单（窗口变窄时把放不下的项收进「…」）的处理。
    -->
    <Style Selector="ui|FANavigationView.ForkTopNav">
        <Setter Property="IsPaneToggleButtonVisible" Value="False" />
    </Style>

    <Style Selector="ui|FANavigationViewItem.ForkTopNav">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10 0" />
    </Style>
</Styles>
