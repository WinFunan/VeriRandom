<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
              xmlns:lv="clr-namespace:SecRandom.Langs.SettingsPages.General.Verification"
             xmlns:oobe="clr-namespace:SecRandom.Langs.FirstRunOobe"
              xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
              x:Class="SecRandom.Views.SettingsPages.General.VerificationSettingsPage"
              x:DataType="local:VerificationSettingsPage"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <fa:FAInfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                          Title="{x:Static lv:Resources.C_WitnessNoticeTitle}"
                          Message="{x:Static lv:Resources.M_WitnessModeNotice}" />

            <fa:FASettingsExpander x:Name="S_VerificationMode"
                                    Header="{x:Static lv:Resources.S_VerificationMode}"
                                    Description="{x:Static lv:Resources.S_VerificationMode_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi ShieldCheckmarkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding SelectedVerificationModeIndex, Mode=OneWay}"
                              SelectionChanged="VerificationMode_OnChanged">
                        <ComboBoxItem Content="{x:Static lv:Resources.O_VerificationMode_Local}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_VerificationMode_Server}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_BeaconEntropy"
                                    Header="{x:Static lv:Resources.S_BeaconEntropy}"
                                    Description="{x:Static lv:Resources.S_BeaconEntropy_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi PulseFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding BeaconEntropyEnabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_TimestampAuthority"
                                    Header="{x:Static lv:Resources.S_TimestampAuthority}"
                                    Description="{x:Static lv:Resources.S_TimestampAuthority_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi ClockFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="TimestampAuthorityToggle" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_BeaconEndpoint"
                                    Header="{x:Static lv:Resources.S_BeaconEndpoint}"
                                    Description="{x:Static lv:Resources.S_BeaconEndpoint_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi GlobeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox MinWidth="260"
                                 Text="{Binding BeaconEndpoint, Mode=TwoWay}" />
                        <Button x:Name="FetchBeaconButton"
                                Content="{x:Static lv:Resources.C_FetchBeacon}"
                                Click="FetchBeacon_OnClick" />
                        <TextBlock x:Name="BeaconStatusText"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   Text="{x:Static lv:Resources.M_BeaconIdle}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_AttestationUpload"
                                    Header="{x:Static lv:Resources.S_AttestationUpload}"
                                    Description="{x:Static lv:Resources.S_AttestationUpload_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi DocumentCheckmarkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel x:Name="AttestationUploadGroup" Spacing="4">
                        <RadioButton x:Name="AttestationUploadOnRadio"
                                     GroupName="SettingsAttestationUpload"
                                     Click="AttestationUpload_OnClick"
                                     Content="{x:Static oobe:Resources.O_AttestationOn}" />
                        <RadioButton x:Name="AttestationUploadOffRadio"
                                     GroupName="SettingsAttestationUpload"
                                     Click="AttestationUpload_OnClick"
                                     Content="{x:Static oobe:Resources.O_AttestationOff}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ProofFolder"
                                    Header="{x:Static lv:Resources.S_ProofFolder}"
                                    Description="{x:Static lv:Resources.S_ProofFolder_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi FolderOpenFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{x:Static lv:Resources.C_OpenProofFolder}"
                                Click="OpenProofFolder_OnClick" />
                        <Button Content="{x:Static lv:Resources.C_OpenVerificationWebsite}"
                                Click="OpenVerificationWebsite_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ProofQueue"
                                    Header="{x:Static lv:Resources.S_ProofQueue}"
                                    Description="{x:Static lv:Resources.S_ProofQueue_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ProofQueueStatusText"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="320" />
                        <Button x:Name="RetryProofQueueButton"
                                Content="{x:Static lv:Resources.C_RetryProofQueue}"
                                Click="RetryProofQueue_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 链判决在每次抽取回执返回时都会更新。它是「本地链被删过或倒退过」唯一的外部信号，
                 所以单独显著提示，而不是埋进上面的计数摘要里 -->
            <TextBlock x:Name="ProofChainAlertText"
                       TextWrapping="Wrap"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       IsVisible="False" />

            <fa:FASettingsExpander x:Name="S_ProofIntegrity"
                                    Header="{x:Static lv:Resources.S_ProofIntegrity}"
                                    Description="{x:Static lv:Resources.S_ProofIntegrity_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi ShieldCheckmarkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ProofIntegrityStatusText"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360" />
                        <Button x:Name="VerifyProofsButton"
                                Content="{x:Static lv:Resources.C_VerifyProofs}"
                                Click="VerifyProofs_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ProofTrust"
                                    Header="{x:Static lv:Resources.S_ProofTrust}"
                                    Description="{x:Static lv:Resources.S_ProofTrust_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi DocumentCheckmarkFilled}}">
                <fa:FASettingsExpanderItem x:Name="S_ProofTrust_Sources"
                                           Content="{x:Static lv:Resources.C_ProofTrust_Sources}">
                    <fa:FASettingsExpanderItem.Footer>
                        <WrapPanel>
                            <CheckBox x:Name="ProofTrustBeacon"
                                      Content="{x:Static lv:Resources.C_ProofTrust_Beacon}"
                                      IsChecked="True"
                                      Margin="0 0 12 0" />
                            <CheckBox x:Name="ProofTrustTimestamp"
                                      Content="{x:Static lv:Resources.C_ProofTrust_Timestamp}"
                                      IsChecked="True"
                                      Margin="0 0 12 0" />
                            <CheckBox x:Name="ProofTrustServer"
                                      Content="{x:Static lv:Resources.C_ProofTrust_Server}"
                                      IsChecked="True"
                                      Margin="0 0 12 0" />
                            <CheckBox x:Name="ProofTrustWitness"
                                      Content="{x:Static lv:Resources.C_ProofTrust_Witness}"
                                      Margin="0 0 12 0" />
                        </WrapPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lv:Resources.C_ProofTrust_WitnessHint}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DatePicker x:Name="ProofTrustWitnessDate" />
                            <TimePicker x:Name="ProofTrustWitnessTime" />
                            <ComboBox x:Name="ProofTrustConfidence"
                                      MinWidth="190"
                                      SelectedIndex="0"
                                      ToolTip.Tip="{x:Static lv:Resources.C_ProofTrust_Confidence}">
                                <ComboBoxItem Content="{x:Static lv:Resources.O_ProofTrust_Confidence_High}" />
                                <ComboBoxItem Content="{x:Static lv:Resources.O_ProofTrust_Confidence_Medium}" />
                                <ComboBoxItem Content="{x:Static lv:Resources.O_ProofTrust_Confidence_Low}" />
                            </ComboBox>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem>
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8">
                            <Button x:Name="AssessProofTrustButton"
                                    Content="{x:Static lv:Resources.C_ProofTrust_Assess}"
                                    Click="AssessProofTrust_OnClick" />
                            <TextBlock x:Name="ProofTrustResultText"
                                       TextWrapping="Wrap"
                                       MaxWidth="440"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_LocalProofStorageLimit"
                                    Header="{x:Static lv:Resources.S_LocalProofStorageLimit}"
                                    Description="{x:Static lv:Resources.S_LocalProofStorageLimit_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi HardDriveFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding SelectedStorageIndex}">
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_16MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_32MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_64MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_128MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_256MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_512MB}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Storage_1GB}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_LocalProofRetention"
                                    Header="{x:Static lv:Resources.S_LocalProofRetention}"
                                    Description="{x:Static lv:Resources.S_LocalProofRetention_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi HistoryFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding SelectedRetentionIndex}">
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_7}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_15}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_30}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_60}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_90}" />
                        <ComboBoxItem Content="{x:Static lv:Resources.O_Retention_Never}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
